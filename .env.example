DATABASE_URL=postgresql://MIS_USER:URL_ENCODED_PASSWORD@coalmine-fleet-pg-783.postgres.database.azure.com:5432/caliber_mis
PUBLIC_APP_URL=https://pulse-ll.cmll.in
DISABLE_SCHEDULED_JOBS=true
META_WHATSAPP_DELIVERY_PAUSED=true
PORT=8080

# Scan duplicates: visual fingerprint skipping at upload (see docs/scan-duplicate-go-live-plan-2026-11-02.md).
# Fingerprints are always computed and stored; skipping by fingerprint is enabled only when this is true.
# Set the two thresholds from scripts/scan-fingerprint-report.mjs before enabling. Exact byte duplicates are always skipped.
# Content duplicates (same date, door and card number read in another entry) are only named on the card for review
# unless SCAN_DUPLICATE_CONTENT_REJECT=true, which rejects such a card automatically into the Duplicates tile.
SCAN_DUPLICATE_FINGERPRINT=false
SCAN_DUPLICATE_CONTENT_REJECT=false
SCAN_DUPLICATE_SKIP_PERCENT=15
SCAN_DUPLICATE_SUSPECT_PERCENT=30

# Platform banner. Leave empty on live: nothing is shown and nothing else changes. The test platform sets TEST so every
# page, including sign-in, carries the yellow "TEST PLATFORM: not the live site" bar and the tab title starts with "[TEST]".
# The server reports the value read-only as environmentLabel on /api/health and /api/app-version; the page never guesses
# from its address. LIVE, PROD and PRODUCTION count as unset.
MIS_ENVIRONMENT_LABEL=
